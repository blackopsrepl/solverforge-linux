[Desktop Entry]
Type=Application
Name=Thunar File Manager
GenericName=File Manager
Comment=Browse the filesystem with SolverForge theming
Exec=solverforge-file-manager %U
Icon=org.xfce.thunar
Terminal=false
StartupNotify=true
Categories=System;Core;GTK;FileManager;Utility;
MimeType=inode/directory;
Actions=open-home;open-computer;open-trash;

[Desktop Action open-home]
Name=Home
Exec=solverforge-file-manager %U

[Desktop Action open-computer]
Name=Computer
Exec=solverforge-file-manager computer:///

[Desktop Action open-trash]
Name=Trash
Exec=solverforge-file-manager trash:///
