{
  "layer": "top",
  "position": "top",
  "margin-top": 3,
  "margin-left": 5,
  "margin-right": 5,
  "spacing": 0,
  "modules-left": [
    "image#solverforge",
    "sway/workspaces",
    "sway/scratchpad",
    "custom/voxtype",
    "custom/cava",
    "sway/language",
    "pulseaudio",
    "custom/codexbar",
    "custom/repobar",
    "custom/trexbar"
  ],
  "modules-center": [
    "clock",
    "custom/notifications"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "temperature",
    "disk",
    "custom/podman",
    "custom/ollama",
    "custom/virsh",
    "custom/updates",
    "network",
    "bluetooth",
    "tray",
    "custom/power-profile",
    "custom/power"
  ],
  "sway/workspaces": {
    "all-outputs": false,
    "disable-scroll": true,
    "format": "{name}"
  },
  "sway/scratchpad": {
    "format": "  {count}",
    "show-empty": false,
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },
  "sway/language": {
    "format": "󰌌  {short}",
    "tooltip-format": "{long}",
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
  },
  "sway/mode": {
    "format": "  {}",
    "max-length": 30
  },
  "sway/window": {
    "max-length": 50,
    "tooltip": false
  },
  "cpu": {
    "format": "  {usage}%",
    "interval": 5,
    "tooltip": true,
    "tooltip-format": "CPU: {usage}% ({avg_frequency} GHz)\n{load} load average",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },
  "memory": {
    "format": "󰍛  {percentage}%",
    "interval": 10,
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.1f} / {total:0.1f} GiB\nSwap: {swapUsed:0.1f} / {swapTotal:0.1f} GiB",
    "states": {
      "warning": 75,
      "critical": 90
    }
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "  {temperatureC}°C",
    "format-critical": "  {temperatureC}°C",
    "interval": 10,
    "tooltip": true,
    "tooltip-format": "CPU temperature: {temperatureC}°C"
  },
  "disk": {
    "format": "󰋊  {percentage_used}%",
    "path": "/",
    "interval": 60,
    "tooltip": true,
    "tooltip-format": "Root: {used} / {total} ({percentage_used}%)\nFree: {free}",
    "states": {
      "warning": 80,
      "critical": 95
    }
  },
  "image#solverforge": {
    "exec": "echo \"${SOLVERFORGE_PATH:-$HOME/.local/share/solverforge}/default/waybar/solverforge-icon.svg\"",
    "size": 18,
    "tooltip": false,
    "on-click": "solverforge-menu"
  },
  "custom/cava": {
    "exec": "solverforge-waybar-cava",
    "tooltip": false,
    "hide-empty-text": true
  },
  "custom/codexbar": {
    "exec": "solverforge-waybar-codexbar",
    "return-type": "json",
    "interval": 15,
    "signal": 9,
    "tooltip": true,
    "on-click": "solverforge-waybar-codexbar open",
    "on-click-middle": "solverforge-waybar-codexbar refresh",
    "on-click-right": "solverforge-waybar-codexbar open"
  },
  "custom/repobar": {
    "exec": "solverforge-waybar-repobar",
    "return-type": "json",
    "interval": 60,
    "signal": 10,
    "tooltip": true,
    "on-click": "solverforge-waybar-repobar open",
    "on-click-middle": "solverforge-waybar-repobar refresh",
    "on-click-right": "solverforge-waybar-repobar open"
  },
  "custom/trexbar": {
    "exec": "solverforge-waybar-trexbar",
    "return-type": "json",
    "interval": 10,
    "signal": 11,
    "tooltip": true,
    "on-click": "solverforge-waybar-trexbar open",
    "on-click-middle": "solverforge-waybar-trexbar refresh",
    "on-click-right": "solverforge-waybar-trexbar open"
  },
  "custom/podman": {
    "exec": "solverforge-waybar-podman",
    "return-type": "json",
    "interval": 10,
    "tooltip": true,
    "on-click": "setsid kitty --app-id sway-float-wide -e solverforge-podman-overview &>/dev/null &"
  },
  "custom/ollama": {
    "exec": "solverforge-waybar-ollama",
    "return-type": "json",
    "interval": 10,
    "tooltip": true,
    "on-click": "setsid kitty --app-id sway-float-wide -e watch -n2 ollama ps &>/dev/null &"
  },
  "custom/virsh": {
    "exec": "solverforge-waybar-virsh",
    "return-type": "json",
    "interval": 10,
    "tooltip": true,
    "on-click": "setsid kitty --app-id sway-float-wide -e solverforge-virsh-overview &>/dev/null &"
  },
  "custom/updates": {
    "exec": "solverforge-waybar-updates",
    "return-type": "json",
    "interval": 3600,
    "tooltip": true,
    "on-click": "setsid kitty --app-id sway-float -e solverforge-pkg-install &>/dev/null &",
    "signal": 8
  },
  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀  {ipaddr}",
    "format-linked": "󰈀  {ifname}",
    "format-disconnected": "󰈂  off",
    "format-alt": "{ifname}: {ipaddr}/{cidr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}\n↑ {bandwidthUpBits} ↓ {bandwidthDownBits}",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}\n↑ {bandwidthUpBits} ↓ {bandwidthDownBits}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click-right": "setsid kitty --app-id sway-float -e nmtui &>/dev/null &"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "  {num_connections}",
    "format-connected-battery": "  {device_battery_percentage}%",
    "tooltip-format": "{controller_address} {status}\n{num_connections} connected",
    "tooltip-format-connected": "{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
    "on-click-right": "setsid kitty --app-id sway-float -e bluetoothctl &>/dev/null &"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  mute",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "󰄋",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "states": {
      "low": 20,
      "midlow": 40,
      "mid": 60,
      "midhigh": 80,
      "high": 100,
      "blasting": 150
    },
    "scroll-step": 5,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip": true,
    "tooltip-format": "{desc}\n{volume}%"
  },
  "custom/voxtype": {
    "exec": "solverforge-waybar-voxtype",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "idle": "󰍬",
      "recording": "󰍬",
      "transcribing": "󰗊",
      "stopped": "󰍭"
    },
    "tooltip": true,
    "on-click": "systemctl --user restart voxtype.service"
  },
  "custom/notifications": {
    "exec": "solverforge-waybar-notifications",
    "return-type": "json",
    "interval": 1,
    "tooltip": true,
    "on-click": "swaync-client -t",
    "on-click-right": "swaync-client -C"
  },
  "custom/power-profile": {
    "exec": "solverforge-waybar-power-profile",
    "return-type": "json",
    "interval": 5,
    "tooltip": true,
    "on-click": "solverforge-menu power",
    "on-click-right": "solverforge-menu system"
  },
  "clock": {
    "format": "  {:%H:%M}",
    "format-alt": "  {:%a %b %d %Y}",
    "interval": 10,
    "tooltip-format": "<span color='#35b9ab'><tt><small>{calendar}</small></tt></span>",
    "calendar": {
      "mode-mon-col": 4,
      "weeks-pos": "left",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#35b9ab'><b>{}</b></span>",
        "weeks": "<span color='#73ba25'><b>{}</b></span>",
        "weekdays": "<span color='#56d4c6'><b>{}</b></span>",
        "today": "<span color='#73ba25'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "solverforge-menu system",
    "on-click-right": "solverforge-menu power"
  }
}
