#!/usr/bin/python3
"""Conservative local Podman/DinD retention and existing file-log rotation."""
import argparse
import base64
from datetime import datetime, timezone
import fcntl
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import time
import urllib.request


STORAGE_POLICY = None


def run(*args):
    if args and args[0] == 'podman' and STORAGE_POLICY is not None:
        ready, reason = storage_ready(STORAGE_POLICY)
        if not ready:
            raise RuntimeError(f'Storage disappeared before Podman operation: {reason}')
        args = (args[0], '--remote=false', *args[1:])
    return subprocess.run(args, check=True, text=True, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, timeout=600).stdout


def load_json(*args):
    return json.loads(run(*args))


def emit(message):
    print(message, flush=True)


def mutate(args, apply):
    emit(('APPLY ' if apply else 'DRY-RUN ') + shlex.join(args))
    if apply:
        emit(run(*args).strip())


def build_processes():
    """Inspect argv, not shell command text (which can contain our own probes)."""
    found = []
    for proc in Path('/proc').glob('[0-9]*'):
        try:
            argv = (proc / 'cmdline').read_bytes().decode().strip('\0').split('\0')
        except FileNotFoundError:
            continue
        except PermissionError as exc:
            raise RuntimeError('Cannot prove process idleness: /proc is restricted') from exc
        executable = Path(argv[0]).name if argv and argv[0] else ''
        if (executable in {'buildah', 'buildctl', 'buildkitd'} or
                executable in {'podman', 'docker'} and
                any(a in {'build', 'buildx', 'commit', 'pull', 'load', 'import'} for a in argv[1:])):
            found.append((proc.name, executable))
    return found


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def forgejo_jobs(config):
    auth_path = config.get('forgejo_auth')
    if not auth_path:
        raise RuntimeError('forgejo_auth not configured; cannot prove CI idle')
    path = Path(auth_path)
    if path.stat().st_mode & 0o077:
        raise RuntimeError('Forgejo credential file must be private (0600)')
    auth = json.loads(path.read_text())
    value = base64.b64encode((auth['username'] + ':' + auth['password']).encode()).decode()
    url = config.get('forgejo_url', 'http://127.0.0.1:3002').rstrip('/')
    if not url.startswith(('http://127.0.0.1:', 'https://')):
        raise RuntimeError('Forgejo Basic auth requires loopback HTTP or HTTPS')
    request = urllib.request.Request(url + '/api/v1/admin/runners/jobs',
                                     headers={'Authorization': 'Basic ' + value})
    with urllib.request.build_opener(NoRedirect).open(request, timeout=30) as response:
        jobs = json.load(response)
    if not isinstance(jobs, list):
        raise ValueError('Unexpected Forgejo jobs API schema')
    return jobs


def jobs_busy(jobs):
    local_labels = {'rust', 'rust-latest', 'rust-slim', 'tauri', 'python',
                    'python-3.13', 'python-slim', 'ruby', 'ruby-latest',
                    'ruby-slim', 'cpp', 'cpp-latest', 'qt', 'qt-latest', 'ubuntu-latest'}
    for job in jobs:
        status = job['status']
        if status not in {'waiting', 'running'}:
            raise ValueError('Unexpected non-active job in active-jobs API')
        if status == 'running' or job['task_id'] or local_labels.intersection(job['runs_on'] or []):
            return True, f"Forgejo job {job['id']} task {job['task_id']} {status}"
    return False, 'no active or assigned local CI jobs'


def forgejo_idle(config, state):
    busy, reason = jobs_busy(forgejo_jobs(config))
    checkpoint = state / 'ci-idle-since'
    if busy:
        checkpoint.unlink(missing_ok=True)
        return False, reason
    now = time.time()
    if not checkpoint.exists():
        checkpoint.write_text(str(now))
        return False, 'first idle observation; waiting 15m'
    since = float(checkpoint.read_text())
    if not 900 <= now - since:
        return False, 'CI idle observation interval shorter than 15m'
    # Also record API polling freshness. An hourly/daily gap cannot prove a
    # continuously idle interval; require two observations 15m apart, with
    # process inspection and native in-use checks as the final safety guards.
    return True, reason


def dind_idle(name, config, state):
    idle, reason = forgejo_idle(config, state)
    if not idle:
        return False, reason
    if run('podman', 'exec', name, 'docker', 'ps', '-q').strip():
        return False, 'running Docker containers'
    top = run('podman', 'top', name, 'comm').splitlines()[1:]
    allowed = {'dockerd', 'containerd', 'docker-init', 'dind-entrypoint', 'sh'}
    if not top or any(line.strip() not in allowed for line in top):
        return False, 'non-daemon processes inside DinD'
    runner_top = run('podman', 'top', name.replace('dind-', 'runner-', 1), 'comm').splitlines()[1:]
    if not runner_top or any(line.strip() != 'forgejo-runner' for line in runner_top):
        return False, 'runner has child processes or is absent'
    return True, reason


def old_build_container(external, metadata, builder, modified, now):
    cid = external['Id']
    if not re.fullmatch('[0-9a-f]{64}', cid) or external.get('State') != 'storage':
        return False
    if metadata.get('id') != cid or builder.get('type') != 'buildah 0.0.1' or builder.get('container-id') != cid:
        return False
    created = datetime.fromisoformat(metadata['created'].replace('Z', '+00:00'))
    if created.tzinfo is None:
        return False
    return 0 < created.timestamp() <= now - 7 * 86400 and modified <= now - 7 * 86400


def external_builds():
    info = load_json('podman', 'info', '--format', 'json')['store']
    graphroot = Path(info['graphRoot']).resolve()
    if STORAGE_POLICY is not None:
        ready, expected = storage_ready(STORAGE_POLICY)
        if not ready or graphroot != Path(expected).resolve():
            raise RuntimeError('Podman graphroot differs from guarded mount')
    driver = info['graphDriverName']
    if not re.fullmatch('[a-z0-9_-]+', driver):
        raise ValueError('Unsafe storage driver name')
    directory = graphroot / (driver + '-containers')
    metadata = {row['id']: row for row in json.loads((directory / 'containers.json').read_text())}
    candidates = []
    for row in load_json('podman', 'ps', '-a', '--external', '--format', 'json'):
        cid = row['Id']
        if row.get('State') != 'storage' or not re.fullmatch('[0-9a-f]{64}', cid):
            continue
        marker = directory / cid / 'userdata/buildah.json'
        if not marker.is_file() or marker.is_symlink():
            emit(f'KEEP external {cid}: no positive Buildah state marker')
            continue
        if old_build_container(row, metadata.get(cid, {}), json.loads(marker.read_text()),
                               marker.stat().st_mtime, time.time()):
            referenced = False
            for proc in Path('/proc').glob('[0-9]*'):
                try:
                    if cid in (proc / 'cgroup').read_text():
                        referenced = True
                        break
                except FileNotFoundError:
                    continue
            if referenced:
                emit(f'KEEP external build {cid}: live process cgroup reference')
            else:
                candidates.append(cid)
        else:
            emit(f'KEEP external {cid}: not a positively identified idle-age build')
    return candidates


def gc(config, state, apply):
    busy = build_processes()
    if busy:
        emit(f'SKIP GC: build/image operations active: {busy}')
        return
    idle, reason = forgejo_idle(config, state)
    if not idle:
        emit(f'SKIP GC: {reason}')
        return
    for cid in external_builds():
        # A fresh API/process/storage snapshot is required for EACH removal.
        idle, reason = forgejo_idle(config, state)
        if not idle or build_processes():
            emit(f'SKIP GC: activity changed ({reason})')
            return
        if cid not in external_builds():
            emit(f'SKIP {cid}: storage metadata changed')
            continue
        # Hidden in 5.4.2 help, but supported; never force or remove volumes.
        mutate(['podman', 'rm', '--storage', cid], apply)
    idle, reason = forgejo_idle(config, state)
    if not idle or build_processes():
        emit(f'SKIP image GC: activity changed ({reason})')
        return
    mutate(['podman', 'image', 'prune', '-f', '--filter', 'until=168h'], apply)
    if os.geteuid() != 0:
        return
    containers = {n for c in load_json('podman', 'ps', '--format', 'json') for n in c['Names']}
    for name in config.get('dind', []):
        if name not in containers:
            emit(f'SKIP {name}: not running')
            continue
        for tail in [
            ['builder', 'prune', '-f', '--filter', 'until=168h'],
            ['image', 'prune', '-f', '--filter', 'until=720h'],
        ]:
            idle, reason = dind_idle(name, config, state)
            if not idle or build_processes():
                emit(f'SKIP {name}: activity changed ({reason})')
                break
            mutate(['podman', 'exec', name, 'docker', *tail], apply)


def rotation_config(paths):
    if not paths:
        return '# No eligible existing Podman file logs.\n'
    quoted = []
    for path in sorted(set(paths)):
        if any(c in path for c in '\n\r"\\{}'):
            raise ValueError('Unsafe logrotate path')
        quoted.append(f'"{path}"')
    return '\n'.join(quoted) + ''' {
    size 50M
    rotate 3
    maxage 14
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
'''


def logs(state, apply):
    info = load_json('podman', 'info', '--format', 'json')
    graphroot = Path(info['store']['graphRoot']).resolve()
    ids = run('podman', 'ps', '-aq').split()
    paths = []
    for cid in ids:
        c = load_json('podman', 'inspect', cid)[0]
        log = c['HostConfig']['LogConfig']
        if log['Type'] not in {'json-file', 'k8s-file'}:
            continue
        path = Path(log['Path'])
        if not path.is_absolute() or path.is_symlink() or not path.resolve().is_relative_to(graphroot):
            raise RuntimeError(f'Refusing log outside graphroot or symlink: {path}')
        if path.exists() and not path.is_file():
            raise RuntimeError(f'Not a regular log: {path}')
        paths.append(str(path))
        emit(f'FILE-LOG {c["Name"]} {path} bytes={path.stat().st_size if path.exists() else 0}')
    target = state / 'container-logs.conf'
    target.write_text(rotation_config(paths))
    emit(f'logrotate config: {target}; {len(paths)} logs; 50MiB x (current + 3 rotations)')
    if paths:
        args = ['/usr/sbin/logrotate', '--state', str(state / 'logrotate.status'), str(target)]
        if not apply:
            args.insert(1, '--debug')
        result = subprocess.run(args, text=True, capture_output=True, timeout=600, check=True)
        emit(result.stdout + result.stderr)


def storage_ready(config):
    """Check the canonical bind mount and filesystem UUID before ANY Podman call."""
    expected = config.get('storage_uuid')
    graphroot = (config.get('rootful_graphroot', '/var/lib/containers/storage')
                 if os.geteuid() == 0 else
                 config.get('rootless_graphroot', str(Path.home() / '.local/share/containers/storage')))
    if not expected:
        return False, 'storage_uuid not configured'
    result = subprocess.run(['findmnt', '--mountpoint', graphroot, '--noheadings',
                             '--output', 'UUID'], text=True, capture_output=True, check=False)
    if result.returncode or result.stdout.strip() != expected:
        return False, f'{graphroot}: required SSD mount UUID {expected} absent/mismatched'
    return True, graphroot


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['gc', 'logs'])
    parser.add_argument('--apply', action='store_true', help='mutate; default is inspection only')
    default_config = Path('/etc/solverforge/container-maintenance.json')
    if os.geteuid() != 0:
        user_config = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config'))) / 'solverforge/container-maintenance.json'
        if user_config.exists():
            default_config = user_config
    parser.add_argument('--config', type=Path, default=default_config)
    args = parser.parse_args()
    config = json.loads(args.config.read_text()) if args.config.exists() else {}
    global STORAGE_POLICY
    STORAGE_POLICY = config
    ready, reason = storage_ready(config)
    if not ready:
        emit(f'SKIP: {reason}; Podman was not invoked')
        return
    state = (Path('/var/lib/solverforge/container-maintenance') if os.geteuid() == 0 else
             Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'solverforge/container-maintenance')
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (state / 'maintenance.lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            emit('SKIP: maintenance already running')
            return
        if args.action == 'gc':
            gc(config, state, args.apply)
        else:
            logs(state, args.apply)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as error:
        print(f'container maintenance failed closed: {error}', file=sys.stderr)
        if isinstance(error, subprocess.CalledProcessError):
            print(error.stderr, file=sys.stderr)
        sys.exit(1)
