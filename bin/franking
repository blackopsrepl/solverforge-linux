#!/bin/bash
set -euo pipefail

resolved_bin=""

if [[ -n "${FRANKING_BIN:-}" && -x "${FRANKING_BIN}" ]]; then
  resolved_bin="${FRANKING_BIN}"
elif [[ -x "${HOME}/.cargo/bin/franking" ]]; then
  resolved_bin="${HOME}/.cargo/bin/franking"
fi

if [[ -z "$resolved_bin" ]]; then
  notify-send "Franking unavailable" \
    "Set FRANKING_BIN or install franking under ~/.cargo/bin."
  exit 1
fi

exec "$resolved_bin" "$@"
