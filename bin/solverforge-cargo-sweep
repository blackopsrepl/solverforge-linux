#!/bin/bash

set -euo pipefail

PATH="$HOME/.cargo/bin:$HOME/.local/share/solverforge/bin:/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/bin:/usr/local/sbin"

ROOT="${SOLVERFORGE_CARGO_SWEEP_ROOT:-$HOME}"
DAYS="${SOLVERFORGE_CARGO_SWEEP_DAYS:-3}"
LOG_TAG="solverforge-cargo-sweep"
LOCK_DIR="$HOME/.cache/solverforge"
LOCK_FILE="$LOCK_DIR/cargo-sweep.lock"

usage() {
    echo "Usage: solverforge-cargo-sweep [--dry-run]" >&2
}

DRY_RUN=()
case "${1:-}" in
    "")
        ;;
    --dry-run)
        DRY_RUN=(--dry-run)
        shift
        ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        usage
        exit 2
        ;;
esac

if [[ $# -ne 0 ]]; then
    usage
    exit 2
fi

if [[ ! "$DAYS" =~ ^[0-9]+$ ]]; then
    logger -t "$LOG_TAG" "Invalid SOLVERFORGE_CARGO_SWEEP_DAYS: $DAYS"
    exit 2
fi

if [[ ! -d "$ROOT" ]]; then
    logger -t "$LOG_TAG" "Sweep root does not exist: $ROOT"
    exit 1
fi

mkdir -p "$LOCK_DIR"
exec 9>"$LOCK_FILE"

if ! flock -n 9; then
    logger -t "$LOG_TAG" "Another cargo sweep is already running"
    exit 0
fi

if ! cargo sweep --help >/dev/null 2>&1; then
    logger -t "$LOG_TAG" "cargo sweep is not available; install cargo-sweep in $HOME/.cargo/bin"
    exit 127
fi

logger -t "$LOG_TAG" "Starting cargo sweep for $ROOT with ${DAYS}-day retention"
set +e
cargo sweep --recursive --time "$DAYS" "${DRY_RUN[@]}" "$ROOT" 2>&1 | logger -t "$LOG_TAG"
status=${PIPESTATUS[0]}
set -e

if [[ $status -eq 0 ]]; then
    logger -t "$LOG_TAG" "Cargo sweep completed successfully for $ROOT"
else
    logger -t "$LOG_TAG" "Cargo sweep failed for $ROOT with exit status $status"
fi

exit "$status"
