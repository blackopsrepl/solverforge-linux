#!/bin/bash

# SolverForge — Install or reinitialize LazyVim with SolverForge defaults.
# Backs up existing nvim config, clones the LazyVim starter, then wires in
# the SolverForge default plugin layer.

set -euo pipefail

SOLVERFORGE_PATH="${SOLVERFORGE_PATH:-$HOME/.local/share/solverforge}"
NVIM_CONFIG="$HOME/.config/nvim"
NVIM_DATA="$HOME/.local/share/nvim"
NVIM_STATE="$HOME/.local/state/nvim"
NVIM_CACHE="$HOME/.cache/nvim"
SF_NVIM="$SOLVERFORGE_PATH/default/nvim"

echo "SolverForge LazyVim Installer"
echo "=============================="
echo ""

# Check for nvim
if ! command -v nvim &>/dev/null; then
  echo "Error: nvim is not installed."
  echo "Install with: sudo zypper install neovim"
  exit 1
fi

echo "nvim version: $(nvim --version | head -1)"
echo ""

# Backup existing config if present
if [[ -d "$NVIM_CONFIG" ]]; then
  echo "Existing nvim config found at $NVIM_CONFIG"
  read -rp "Back up and replace? [y/N]: " confirm
  if [[ "${confirm,,}" != "y" ]]; then
    echo "Cancelled."
    exit 0
  fi

  backup_dir="$HOME/.config/nvim.bak.$(date +%Y%m%d%H%M%S)"
  echo "Backing up to $backup_dir"
  mv "$NVIM_CONFIG" "$backup_dir"

  # Clean slate for lazy.nvim data
  rm -rf "$NVIM_DATA/lazy"
  rm -rf "$NVIM_STATE"
  rm -rf "$NVIM_CACHE"
  echo "Cleaned nvim data/state/cache."
fi

# Clone LazyVim starter
echo ""
echo "Cloning LazyVim starter..."
git clone https://github.com/LazyVim/starter "$NVIM_CONFIG"

# Remove the starter's .git so it doesn't interfere
rm -rf "$NVIM_CONFIG/.git"

# Remove the example plugin file (inactive boilerplate)
rm -f "$NVIM_CONFIG/lua/plugins/example.lua"

echo ""
echo "Wiring SolverForge defaults..."

# Copy SolverForge plugin specs into the plugins directory
for plugin_file in "$SF_NVIM"/plugins/*.lua; do
  [[ -f "$plugin_file" ]] || continue
  cp "$plugin_file" "$NVIM_CONFIG/lua/plugins/"
  echo "  Added $(basename "$plugin_file")"
done

# Copy lazyvim.json extras preset
if [[ -f "$SF_NVIM/lazyvim.json" ]]; then
  cp "$SF_NVIM/lazyvim.json" "$NVIM_CONFIG/lazyvim.json"
  echo "  Applied language extras preset (17 languages)"
fi

# Copy stylua config
if [[ -f "$SF_NVIM/stylua.toml" ]]; then
  cp "$SF_NVIM/stylua.toml" "$NVIM_CONFIG/stylua.toml"
  echo "  Applied stylua formatting config"
fi

echo ""
echo "Done. Launch nvim to complete plugin installation."
echo ""
echo "SolverForge defaults installed:"
echo "  - Hackerman theme (transparent)"
echo "  - File explorer on right side"
echo "  - Evangelion + Nightfox colorschemes available"
echo "  - Harpoon 2 for file bookmarking"
echo "  - 17 language packs (C/C++, Go, Rust, Python, Ruby, Java, etc.)"
echo "  - StyLua formatting (2-space indent, 120 columns)"
echo ""
echo "To customize, edit files in ~/.config/nvim/lua/plugins/"
echo "SolverForge defaults live in $SF_NVIM/"
