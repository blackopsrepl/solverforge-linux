#!/bin/bash
set -euo pipefail

# SolverForge — VIGILANCE backup script
# Sources shared configuration from SolverForge backup.conf

SOLVERFORGE_PATH="${SOLVERFORGE_PATH:-$HOME/.local/share/solverforge}"

# Load backup configuration (default layer, then user override)
# shellcheck source=/dev/null
source "$SOLVERFORGE_PATH/default/bash/backup.conf"
# shellcheck source=/dev/null
[[ -f "$HOME/.config/solverforge/backup.conf" ]] && source "$HOME/.config/solverforge/backup.conf"

LOG_TAG="restic-backup"
LOCK_FILE="${SOLVERFORGE_BACKUP_LOCK:-/run/solverforge-backup/lock}"

exec 9>"$LOCK_FILE"
flock 9

backup_path() {
    local path="$1"
    logger -t "$LOG_TAG" "Starting backup for $path"

    if restic -q -r "$RESTIC_REPO" \
        --password-file "$RESTIC_PASSWORD_FILE" \
        backup --exclude-file="$RESTIC_EXCLUDE_FILE" "$path"; then
        logger -t "$LOG_TAG" "Backup completed successfully for $path"
        return 0
    else
        logger -t "$LOG_TAG" "Backup failed for $path"
        return 1
    fi
}

for path in "${BACKUP_PATHS[@]}"; do
    backup_path "$path"
done
